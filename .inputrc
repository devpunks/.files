#
#      d8b                            888
#      Y8P                            888
#                                     888
#      888 88888b.  88888b.  888  888 888888 888d888 .d8888b
#      888 888 "88b 888 "88b 888  888 888    888P"  d88P"
#      888 888  888 888  888 888  888 888    888    888
#  d8b 888 888  888 888 d88P Y88b 888 Y88b.  888    Y88b.
#  Y8P 888 888  888 88888P"   "Y88888  "Y888 888     "Y8888P
#                   888
#                   888
#                   888
# CtrlP -----------------------------------------------------
#
# -------------------------------------------------------------------------
# Version: 0.1
# File: .inputrc
# Source: https://github.com/devpunks
# Author: Ahmid-Ra (github.com/snuggs)
# Maintainer: devPunks <https://github.com/devpunks>
# Description: Readline Run Commands on $SHELL prompt.
# This file controls the behaviour of line input editing for
# programs that use the GNU Readline library.  Existing
# programs include FTP, Bash, and GDB.
# -------------------------------------------------------------------------
#
#
# See to avoid potential conflicts:
#   - $HOME/.vimrc
#   - $HOME/.tmux.conf
#   - $PREFIX/etc/inputrc
#   - $HOME/.termux/termux.properties
# -------------------------------------------------------------------------
#   - https://keycombiner.com/collections/terminal
#   - https://ioflood.com/blog/bind-linux-command
#   - https://man7.org/linux/man-pages/man3/readline.3.html
#   - https://topbug.net/blog/2017/07/31/inputrc-for-humans
#   - https://geeksforgeeks.org/bind-command-in-linux-with-examples
#   - https://tldp.org/LDP/lfs/LFS-BOOK-6.1.1-HTML/chapter07/inputrc.html
#   - https://gnu.org/software/bash/manual/html_node/Sample-Init-File.html
#   - https://unix.stackexchange.com/q/529385/i-key-is-not-functional-in-bash
#   - https://unix.stackexchange.com/q/153357/inputrc-file-not-sourcing-correctly
#   - https://gnu.org/software/bash/manual/html_node/Readline-Init-File-Syntax.html
#
# =========================================================================
# NOTE: Set directives (options) are GLOBAL — they affect all keymaps.
#       Key bindings are KEYMAP-SPECIFIC — repeated in each section below.
#       The $include MUST come before set editing-mode so the system's
#       $if mode=emacs conditionals still match correctly.
# =========================================================================

# ── Load system defaults (must be before set editing-mode) ──
$include /data/data/com.termux/files/usr/etc/inputrc

# ── Use vi keybindings (Esc toggles insert/command mode) ──
set editing-mode vi
#set editing-mode emacs

# =========================================================================
# {{{ Global Options
# =========================================================================

# How long (ms) to wait for multi-key sequences like \C-x\C-r
set keyseq-timeout 300

# Allow 8-bit / UTF-8 input (non-ASCII chars like →, «, ñ)
set input-meta on

# Allow 8-bit / UTF-8 output
set output-meta on

# Don't strip high bit from meta characters
set convert-meta off

# Enable application keypad (terminal-specific arrow keys)
set enable-keypad on

# Show file type suffixes in completions: */@ (like ls -F)
set visible-stats on

# Number of history entries kept in memory
set history-size 1000

# Flash screen on error instead of beeping
set bell-style visible

# Show trailing / on directory completions
set mark-directories on

# Show trailing / on symlink-to-directory completions
set mark-symlinked-directories on

# Disable bracketed paste (avoids 200~ artifacts in Termux)
set enable-bracketed-paste off

# }}}

# =========================================================================
# {{{ Completion Options
# =========================================================================

# Briefly highlight matching parenthesis when typing
set blink-matching-paren on

# Color the common prefix of tab completions
set colored-completion-prefix on

# Color filenames using LS_COLORS during completion
set colored-stats on

# Don't paginate — show all completion results at once
set page-completions off

# Include hidden files (dotfiles) in completions
set match-hidden-files on

# Treat hyphen and underscore as equivalent for matching
set completion-map-case on

# Don't replace text after cursor when completing
set skip-completed-text on

# Show all matches immediately if ambiguous
set show-all-if-ambiguous on

# Ignore case when completing
set completion-ignore-case on

# Show all matches even if prefix is unique
set show-all-if-unmodified on

# Show control characters as ^C, ^D, etc.
set echo-control-characters on

# Number of columns for completion display (3 = side-by-side)
set completion-display-width 3

# Max matches to show before prompting "Display all N?"
set completion-query-items 200

# Show common prefix during menu-complete cycling
set menu-complete-display-prefix on

# Fill completions left-to-right, then down
set print-completions-horizontally on

# Truncate long common prefix, showing last N chars
set completion-prefix-display-length 5

# }}}

# =========================================================================
# {{{ Mode Strings
# =========================================================================

# Show current vi mode (insert/command) in the prompt
set show-mode-in-prompt on

# Emacs mode indicator + blinking bar cursor
set emacs-mode-string (emacs) \1\e[0m\e[5 q\2

# Vi insert indicator + red underline cursor
set vi-ins-mode-string  ➥【vi  】\1\e]12;red\a\e[3 q\2

# Vi command indicator + blue block cursor + lock icon
set vi-cmd-mode-string  ➥【vi🔏】\1\e]12;blue\a\e[2 q\2

# }}}

# =========================================================================
# {{{ Bindings — emacs keymap
# =========================================================================
set keymap emacs

# Tab — complete current word
TAB: complete

# Ctrl+X Ctrl+R — reload this .inputrc file
"\C-x\C-r": re-read-init-file

# Ctrl+L — clear screen (keeps scrollback)
"\C-l": clear-screen

# Ctrl+X Ctrl+L — clear display (wipes scrollback too)
"\C-x\C-l": clear-display

# Ctrl+A — jump to start of line
"\C-a": beginning-of-line

# Ctrl+E — jump to end of line
"\C-e": end-of-line

# Home key — jump to start of line
"\e[1~": beginning-of-line

# Insert key — insert next key literally
"\e[2~": quoted-insert

# Delete key — delete char under cursor
"\e[3~": delete-char

# End key — jump to end of line
"\e[4~": end-of-line

# Fn+End / variant — jump to end of line
"\e[8~": end-of-line

# Right arrow — move cursor forward one char
"\e[C": forward-char

# Left arrow — move cursor backward one char
"\e[D": backward-char

# Ctrl+Right — move forward one word
"\e[5C": forward-word

# Ctrl+Left — move backward one word
"\e[5D": backward-word

# Ctrl+Right (alt seq) — move forward one word
"\e[1;5C": forward-word

# Ctrl+Left (alt seq) — move backward one word
"\e[1;5D": backward-word

# Up arrow — search history for lines matching what's typed
"\e[A": history-search-backward

# Down arrow — search forward through history
"\e[B": history-search-forward

# Ctrl+P — previous command (search by prefix)
"\C-p": history-search-backward

# Ctrl+N — next command (search by prefix)
"\C-n": history-search-forward

# =========================================================================
# {{{ Bindings — vi-command keymap
# =========================================================================
set keymap vi-command

# Tab — complete current word
TAB: complete

# Ctrl+X Ctrl+R — reload this .inputrc file
"\C-x\C-r": re-read-init-file

# Ctrl+L — clear screen (keeps scrollback)
"\C-l": clear-screen

# Ctrl+X Ctrl+L — clear display (wipes scrollback)
"\C-x\C-l": clear-display

# Ctrl+A — jump to start of line
"\C-a": beginning-of-line

# Ctrl+E — jump to end of line
"\C-e": end-of-line

# Home key — jump to start of line
"\e[1~": beginning-of-line

# Delete key — delete char under cursor
"\e[3~": delete-char

# End key — jump to end of line
"\e[4~": end-of-line

# Fn+End — jump to end of line
"\e[8~": end-of-line

# Right arrow — move cursor forward one char
"\e[C": forward-char

# Left arrow — move cursor backward one char
"\e[D": backward-char

# Ctrl+Right — move forward one word
"\e[5C": forward-word

# Ctrl+Left — move backward one word
"\e[5D": backward-word

# Ctrl+Right (alt seq) — move forward one word
"\e[1;5C": forward-word

# Ctrl+Left (alt seq) — move backward one word
"\e[1;5D": backward-word

# Up arrow — search history by typed prefix
"\e[A": history-search-backward

# Down arrow — search forward through history
"\e[B": history-search-forward

# Ctrl+P — previous command (prefix search)
"\C-p": history-search-backward

# Ctrl+N — next command (prefix search)
"\C-n": history-search-forward

# =========================================================================
# {{{ Bindings — vi-insert keymap
# =========================================================================
set keymap vi-insert

# Tab — complete current word
TAB: complete

# Ctrl+X Ctrl+R — reload this .inputrc file
"\C-x\C-r": re-read-init-file

# Ctrl+L — clear screen (keeps scrollback)
"\C-l": clear-screen

# Ctrl+X Ctrl+L — clear display (wipes scrollback)
"\C-x\C-l": clear-display

# Ctrl+A — jump to start of line
"\C-a": beginning-of-line

# Ctrl+E — jump to end of line
"\C-e": end-of-line

# Home key — jump to start of line
"\e[1~": beginning-of-line

# Insert key — insert next key literally
"\e[2~": quoted-insert

# Delete key — delete char under cursor
"\e[3~": delete-char
"\e[4~": end-of-line
"\e[8~": end-of-line

"\e[C": forward-char
"\e[D": backward-char

"\e[5C": forward-word
"\e[5D": backward-word
"\e[1;5C": forward-word
"\e[1;5D": backward-word

"\e[A": history-search-backward
"\e[B": history-search-forward

"\C-p": history-search-backward
"\C-n": history-search-forward

# vi-insert specific: quoted-insert on Ctrl+Q and Ctrl+V
"\C-q": quoted-insert
"\C-v": quoted-insert

# }}}

# vim: foldmethod=marker